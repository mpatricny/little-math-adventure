{
  "name": "@cislokraj/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gameplay:report": "tsx src/gameplayReport.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "better-auth": "1.7.4",
    "hono": "^4.9.0",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.0",
    "typescript": "~5.6.2"
  }
}
