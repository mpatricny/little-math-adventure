# Development-only example. Production values belong in Doppler/Railway.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://cislokraj:cislokraj@127.0.0.1:5433/cislokraj_dev
CORS_ORIGINS=http://localhost:8002,http://localhost:8012
# For the API without sign-in, omit all three credential variables below.
# A base URL alone is allowed; any credential requires the complete OAuth setup.
BETTER_AUTH_URL=http://localhost:8002
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
APP_RELEASE=dev
LOG_LEVEL=debug

# Both analytics flags are opt-in. Apply migrations 0005–0009 before enabling.
ANALYTICS_ADMIN_ENABLED=false
ANALYTICS_COLLECTION_ENABLED=false
# Verified Google email is pinned to its provider subject on first authorized login.
ADMIN_BOOTSTRAP_EMAIL=mpatricny@gmail.com
# Optional additional explicit Google provider subjects, comma separated (not emails).
ADMIN_GOOGLE_SUBJECTS=
