{
  "name": "little-math-adventure",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "dev:pilot": "vite --mode pilot --port 8002 --strictPort",
    "dev:tv": "vite --host 0.0.0.0 --port 8001",
    "remote:relay": "node scripts/remote-relay.mjs",
    "build": "npm run build:pilot",
    "build:pilot": "vite build --mode pilot",
    "build:dev": "vite build --mode development",
    "preview": "npm run preview:pilot",
    "preview:pilot": "vite preview --mode pilot --port 8012 --strictPort",
    "preview:dev": "vite preview --mode development --port 8011 --strictPort",
    "test": "vitest run",
    "test:pilot-content": "node --test scripts/__tests__/pilot-content.test.mjs",
    "test:landing": "node scripts/check-landing.mjs",
    "test:game-account": "node scripts/check-game-account.mjs",
    "test:infra": "node --test infra/cloudflare/worker.test.mjs && npm run api:test",
    "api:dev": "npm --prefix server run dev",
    "api:build": "npm --prefix server run build",
    "api:test": "npm --prefix server test",
    "api:typecheck": "npm --prefix server run typecheck",
    "api:db:migrate": "npm --prefix server run db:migrate",
    "infra:db:up": "docker compose -f compose.dev.yaml up -d postgres",
    "infra:db:down": "docker compose -f compose.dev.yaml down",
    "cloudflare:check": "npm run build:pilot && node infra/cloudflare/check-assets.mjs",
    "cloudflare:dry-run": "npm run cloudflare:check && wrangler deploy --dry-run",
    "cloudflare:deploy": "npm run cloudflare:check && wrangler deploy",
    "test:e2e:puzzles": "playwright test --config e2e/puzzles/playwright.config.ts",
    "test:e2e:arena": "playwright test --config e2e/arena/playwright.config.ts",
    "test:e2e:preparation": "playwright test --config e2e/preparation/playwright.config.ts",
    "test:e2e:underwater": "playwright test --config e2e/underwater/playwright.config.ts",
    "test:e2e:audio": "playwright test --config e2e/audio/playwright.config.ts",
    "test:e2e:shop": "playwright test --config e2e/shop/playwright.config.ts"
  },
  "dependencies": {
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "playwright": "^1.58.2",
    "railway": "^3.11.0",
    "sharp": "^0.35.4",
    "typescript": "~5.6.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.34.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "picomatch": "4.0.7",
    "postcss": "8.5.28",
    "rollup": "4.63.1"
  }
}
