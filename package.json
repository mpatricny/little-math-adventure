{
  "name": "little-math-adventure",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "dev:tv": "vite --host 0.0.0.0 --port 8001",
    "remote:relay": "node scripts/remote-relay.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e:puzzles": "playwright test --config e2e/puzzles/playwright.config.ts",
    "test:e2e:arena": "playwright test --config e2e/arena/playwright.config.ts",
    "test:e2e:preparation": "playwright test --config e2e/preparation/playwright.config.ts",
    "test:e2e:underwater": "playwright test --config e2e/underwater/playwright.config.ts",
    "test:e2e:audio": "playwright test --config e2e/audio/playwright.config.ts",
    "test:e2e:shop": "playwright test --config e2e/shop/playwright.config.ts"
  },
  "dependencies": {
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "playwright": "^1.58.2",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.0"
  }
}
